# Normalisation des fins de ligne
# Evite le bruit CRLF/LF lors des allers-retours via All-in-One WP Migration
* text=auto eol=lf

*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Fichiers binaires
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.pdf  binary
*.zip  binary
